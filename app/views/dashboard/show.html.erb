<div class="container">
  <h3 class="welcome-message">Welcome, <%= current_user.name %>!</h3>

  <% if current_user.admin? %>
    <div class="admin-dashboard">
      <div class="card-header">Admin Dashboard</div>

      <% if @pending_payments.present? %>
        <h3>Pending Payments</h3>
        <table class="pending-payments-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Task Title</th>
              <th>Amount</th>
              <th>Transaction ID</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pending_payments.each do |payment| %>
              <tr>
                <td><%= payment.id %></td>
                <td><%= payment.task.title %></td>
                <td><%= number_to_currency(payment.task.budget) %></td>
                <td><%= payment.transaction_id %></td>
                <td>
                  <%= form_with url: accept_task_payment_path(payment.task, payment), method: :patch do %>
                    <%= submit_tag 'Accept', class: 'accept-button' %>
                  <% end %>
                  <%= form_with url: reject_task_payment_path(payment.task, payment), method: :patch do %>
                    <%= submit_tag 'Reject', class: 'reject-button' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>No pending payments at this time.</p>
      <% end %>

      <div class="card-body">
        <ul class="stats-list">
          <li>Total Tasks: <span class="badge"><%= Task.count %></span></li>
          <li>Total Clients: <span class="badge"><%= User.client.count %></span></li>
          <li>Total Freelancers: <span class="badge"><%= User.freelancer.count %></span></li>
        </ul>
      </div>
    </div>

    <div class="admin-dashboard">
      <div class="card-header">All Tasks</div>
      <div class="card-body">
        <ul class="task-list">
          <% Task.all.each do |task| %>
            <li class="task-item">
              <%= link_to task.title, task_path(task) %> - 
              <span class="status-badge">Status: <%= task.status %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="admin-dashboard">
      <div class="card-header">All Reviews</div>
      <div class="card-body">
        <ul class="review-list">
          <% Review.all.each do |review| %>
            <li class="review-item">
              Review for <%= link_to review.task.title, task_path(review.task) %>: 
              <span class="rating-badge"><%= review.rating %> stars</span> - <%= review.comment %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="manage-users-section">
      <h4>Manage Users</h4>
      <table class="user-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% User.all.each do |user| %>
            <tr>
              <td><%= user.email %></td>
              <td><%= user.role.capitalize %></td>
              <td>
                <%= link_to 'Delete', admin_destroy_user_path(user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'delete-button' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= link_to 'Create New User', new_freelancer_registration_path, class: 'create-user-button' %>
    </div>

   <% elsif current_user.client? %>
    <!-- Client Dashboard Content -->
    <div class="client-dashboard">
      <div class="card-header">Client Dashboard</div>
      <div class="card-body">
        <%= link_to 'Create New Task', new_task_path, class: "create-task-button" %>

        <!-- Payment Information Section -->
        <div class="payments-info">
          <h5>Payments</h5>
          <p>For payments, you can transfer funds to the following mobile numbers:</p>
          <ul class="payment-list">
            <li>MTN: <span class="payment-number">+260960231978</span></li>
            <li>Airtel: <span class="payment-number">+260777945779</span></li>
          </ul>
        </div>

        <!-- Tasks Section -->
        <% Task.statuses.keys.each do |status| %>
          <div class="tasks-section">
            <h5>Your Tasks - <%= status.titleize %></h5>
            <div class="table-responsive">
              <table class="tasks-table">
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Budget</th>
                    <th>Category</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% current_user.tasks_as_client.where(status: status).each do |task| %>
                    <tr>
                      <td><%= link_to task.title, task_path(task) %></td>
                      <td><%= task.description %></td>
                      <td><%= number_to_currency(task.budget) %></td>
                      <td><%= task.category %></td>
                      <td><%= task.deadline.strftime('%b %d, %Y') %></td>
                      <td><span class="status-badge"><%= task.status.titleize %></span></td>
                      <td>
                        <% if task.completed? %>
                          <% if task.payment.nil? %>
                            <%= link_to 'Pay', new_task_payment_path(task), class: 'pay-button' %>
                          <% elsif task.payment.rejected? %>
                            <span class="status-badge rejected">Rejected</span>
                            <%= link_to 'Pay Again', new_task_payment_path(task), class: 'pay-button' %>
                          <% elsif task.payment.approved? %>
                            <%= link_to 'View', task_path(task), class: 'view-button' %>
                          <% end %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Your Reviews Section -->
    <div class="reviews-section">
      <div class="card-header">Your Reviews</div>
      <div class="card-body">
        <ul class="review-list">
          <% if current_user&.given_reviews&.any? %>
            <% current_user.given_reviews.each do |review| %>
              <li class="review-item">
                Review for <%= link_to review.task.title, task_path(review.task) %>
                <span class="rating-badge"><%= review.rating %> stars</span> - <%= review.comment %>
              </li>
            <% end %>
          <% else %>
            <li>No reviews available.</li>
          <% end %>
        </ul>
      </div>
    </div>

  <% elsif current_user.freelancer? %>
    <!-- Freelancer Dashboard Content -->
    <div class="freelancer-dashboard">
      <!-- Available Tasks Section -->
      <div class="card-header">Available Tasks</div>
      <div class="card-body">
        <h4>Available Tasks</h4>
        <div class="table-responsive">
          <table class="available-tasks-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Earning</th>
                <th>Category</th>
                <th>Deadline</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% Task.open_tasks.each do |task| %>
                <tr>
                  <td><%= link_to task.title, task_path(task) %></td>
                  <td><%= task.description %></td>
                  <td><%= number_to_currency(task.budget * 0.80) %></td>
                  <td><%= task.category %></td>
                  <td><%= l(task.deadline, format: :short) %></td>
                  <td><%= task.status %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tasks You're Working On Section -->
      <div class="card-header">Tasks You're Working On</div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="working-tasks-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Budget</th>
                <th>Category</th>
                <th>Deadline</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% current_user.tasks_as_freelancer.each do |task| %>
                <tr>
                  <td><%= link_to task.title, task_path(task) %></td>
                  <td><%= task.description %></td>
                  <td><%= number_to_currency(task.budget * 0.80) %></td>
                  <td><%= task.category %></td>
                  <td><%= task.deadline.strftime('%b %d, %Y') %></td>
                  <td><span class="status-badge"><%= task.status.titleize %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tasks You've Completed Section -->
      <div class="card-header">Tasks You've Completed</div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="completed-tasks-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Budget</th>
                <th>Category</th>
                <th>Deadline</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% current_user.tasks_as_freelancer.completed.each do |task| %>
                <tr>
                  <td><%= link_to task.title, task_path(task) %></td>
                  <td><%= task.description %></td>
                  <td><%= number_to_currency(task.budget * 0.80) %></td>
                  <td><%= task.category %></td>
                  <td><%= task.deadline.strftime('%b %d, %Y') %></td>
                  <td><span class="status-badge"><%= task.status.titleize %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="card-header">Reviews</div>
      <div class="card-body">
        <ul class="review-list">
          <% if current_user&.received_reviews&.any? %>
            <% current_user.received_reviews.each do |review| %>
              <li class="review-item">
                Review for <%= link_to review.task.title, task_path(review.task) %>
                <span class="rating-badge"><%= review.rating %> stars</span> - <%= review.comment %>
              </li>
            <% end %>
          <% else %>
            <li>No reviews available.</li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
